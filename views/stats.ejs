<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> · Kintsu Vault Metrics</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        .stats-wrapper {
            max-width: 1100px;
            margin: 40px auto;
            padding: 0 24px;
        }
        .stats-header {
            background: #FFF;
            border: 3px solid #000;
            box-shadow: 6px 6px 0px #000;
            padding: 28px;
            margin-bottom: 32px;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 20px;
            margin-bottom: 32px;
        }
        .stat-card {
            background: #FFF;
            border: 3px solid #000;
            box-shadow: 5px 5px 0px #000;
            padding: 24px;
        }
        .stat-num {
            font-size: 3rem;
            font-weight: 800;
            font-family: var(--font-mono, monospace);
            line-height: 1;
            margin: 12px 0 6px 0;
        }
        .engine-badge {
            display: inline-block;
            background: #2DD4A8;
            color: #000;
            border: 2px solid #000;
            box-shadow: 3px 3px 0 #000;
            font-weight: 700;
            padding: 4px 12px;
            font-size: 0.85rem;
            text-transform: uppercase;
        }
        .table-card {
            background: #FFF;
            border: 3px solid #000;
            box-shadow: 6px 6px 0px #000;
            padding: 28px;
        }
        .neo-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 16px;
        }
        .neo-table th, .neo-table td {
            border: 2px solid #000;
            padding: 12px 16px;
            text-align: left;
        }
        .neo-table th {
            background: #FDF2F8;
            font-weight: 700;
        }
        .pill-badge {
            background: #FFF2FB;
            border: 1.5px solid #000;
            padding: 2px 8px;
            font-size: 0.8rem;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <header class="dash-navbar">
        <div class="nav-container">
            <a href="/index.html" class="nav-brand">
                <div class="logo-box">
                    <span class="logo-icon">✦</span>
                </div>
                <span class="logo-text">Kintsu</span>
            </a>
            <nav class="nav-pill-actions">
                <a href="/dashboard.html" class="nav-pill">Dashboard</a>
                <a href="/flashcards.html" class="nav-pill">Flashcards</a>
                <a href="/stats" class="nav-pill active-pill">EJS Metrics</a>
            </nav>
        </div>
    </header>

    <main class="stats-wrapper">
        <div class="stats-header">
            <span class="engine-badge">Server-Side Rendered with EJS Engine</span>
            <h1 style="margin: 14px 0 6px 0; font-size: 2.2rem; font-weight: 800;">Platform Live Metrics & Vault Health</h1>
            <p style="margin: 0; color: #555;">Dynamically rendered at runtime by Express.js via <code>views/stats.ejs</code>.</p>
            <div style="margin-top: 12px;">
                <strong>Database State:</strong> 
                <% if (dbConnected) { %>
                    <span style="color: #059669; font-weight: 700;">MongoDB Live (Mongoose ODM Connected)</span>
                <% } else { %>
                    <span style="color: #D97706; font-weight: 700;">Dual-Mode Fallback Active (Local JSON Disk Storage)</span>
                <% } %>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card" style="background: #FFF2FB;">
                <span style="font-weight: 700; text-transform: uppercase;">Total Study Notes</span>
                <div class="stat-num" style="color: #EC329F;"><%= notes.length %></div>
                <span style="font-size: 0.9rem; color: #555;">Persisted in Kintsu Vault</span>
            </div>

            <div class="stat-card" style="background: #FEF9C3;">
                <span style="font-weight: 700; text-transform: uppercase;">Active Flashcards</span>
                <div class="stat-num" style="color: #CA8A04;"><%= flashcards.length %></div>
                <span style="font-size: 0.9rem; color: #555;">Active-Recall Decks</span>
            </div>

            <div class="stat-card" style="background: #E0E7FF;">
                <span style="font-weight: 700; text-transform: uppercase;">Registered Scholars</span>
                <div class="stat-num" style="color: #4338CA;"><%= users.length %></div>
                <span style="font-size: 0.9rem; color: #555;">User Accounts on Platform</span>
            </div>
        </div>

        <div class="table-card">
            <h2 style="margin: 0 0 8px 0; font-size: 1.4rem;">Recent Notes in Server Memory</h2>
            <p style="margin: 0 0 16px 0; color: #666; font-size: 0.95rem;">Rendered dynamically using EJS template loops (<code>&lt;% notes.forEach(...) %&gt;</code>):</p>
            
            <% if (notes.length === 0) { %>
                <p style="padding: 20px; background: #FFF2FB; border: 2px dashed #000;">No notes found in server storage yet. Create one from the Dashboard!</p>
            <% } else { %>
                <div style="overflow-x: auto;">
                    <table class="neo-table">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Subject</th>
                                <th>Board</th>
                                <th>Pinned</th>
                                <th>Created</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% notes.slice(0, 8).forEach(function(note) { %>
                                <tr>
                                    <td><strong><%= note.title %></strong></td>
                                    <td><span class="pill-badge"><%= note.subject || 'General' %></span></td>
                                    <td><%= note.board || 'All Notes' %></td>
                                    <td><%= note.pinned ? 'Yes' : 'No' %></td>
                                    <td style="font-size: 0.85rem; font-family: monospace;">
                                        <%= note.createdAt ? new Date(note.createdAt).toLocaleDateString() : 'N/A' %>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } %>

            <div style="margin-top: 24px; text-align: right;">
                <a href="/dashboard.html" class="nav-pill active-pill" style="display: inline-block; text-decoration: none;">&larr; Return to Dashboard</a>
            </div>
        </div>
    </main>
</body>
</html>
