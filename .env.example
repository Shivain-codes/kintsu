# Kintsu Server Configuration
PORT=3333

# MongoDB Connection String (MongoDB Atlas or local daemon)
# If left commented or unavailable, Kintsu gracefully falls back to local JSON persistence!
MONGODB_URI=mongodb://127.0.0.1:27017/kintsu

# Environment Mode
NODE_ENV=development

# Google sign-in: OAuth Web client ID from Google Cloud Console
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
